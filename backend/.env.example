# Database — SQL Server via ODBC
# Windows Auth (no user/pass needed on domain machine):
DATABASE_URL=mssql+aioodbc://@localhost/aivora_db?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
# SQL Auth (use this if Windows Auth is not available):
# DATABASE_URL=mssql+aioodbc://sa:YourPassword@localhost/aivora_db?driver=ODBC+Driver+17+for+SQL+Server

# JWT — generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_32_BYTE_HEX

# Token lifetimes (configurable)
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_HOURS=8

# Password hashing cost factor (higher = slower = more secure)
BCRYPT_ROUNDS=12

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000
